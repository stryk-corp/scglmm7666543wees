
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true;
    }

    function isDashboardReader() {
      return request.auth != null
        && request.auth.token.get('dashboardReader', false) == true;
    }

    function canReadDashboard() {
      return isAdmin() || isDashboardReader();
    }

    function hasSupportedDocumentType(data) {
      return !data.keys().hasAny(['documentType'])
        || data.documentType in ['siwes_report', 'term_paper', 'essay'];
    }

    function hasSupportedGenerationPaymentType(data) {
      return !data.keys().hasAny(['generationPayment'])
        || data.generationPayment == null
        || (data.generationPayment is map
          && (
            !data.generationPayment.keys().hasAny(['documentType'])
            || data.generationPayment.documentType in ['siwes_report', 'term_paper', 'essay']
          ));
    }

    // Admin config is accessed only through trusted server-side Admin SDK code.
    match /admin/config {
      allow read: if false;
    }

    match /users/{userId} {
      // User can read/update/delete their own profile
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Admin and dashboard-reader sessions may inspect profiles.
      allow read: if canReadDashboard();
      // Allow specific fields to be updated by the user
      allow update: if request.auth != null && request.auth.uid == userId
                    && !isDashboardReader()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['fullName', 'regNumber', 'universityName', 'facultyName', 'departmentName', 'bankName', 'accountNumber', 'accountName', 'balance']);

      // Admins can update referral status, counts, and balances
      allow update: if isAdmin()
                    && !isDashboardReader()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['isReferralActive', 'referralCount', 'referralBalance', 'balance', 'referralCommissionRate']);

      // Allow any authenticated user to create their own user document.
      allow create: if request.auth != null && !isDashboardReader();
      
      // Admins can list all users
      allow list: if canReadDashboard();

      // Only server-side admin actions can update referral balance and count.
      // This rule is to allow server-side increments. The client-side update for other
      // profile fields is handled above.
      allow write: if isAdmin() && !isDashboardReader();


      match /reports/{reportId} {
        allow read: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader()
          && hasSupportedDocumentType(request.resource.data)
          && hasSupportedGenerationPaymentType(request.resource.data);
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
      }
      
      match /notifications/{notificationId} {
        allow read, list: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
        allow write: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
      }

      match /drafts/{draftId} {
        allow read: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader()
          && hasSupportedDocumentType(request.resource.data)
          && hasSupportedGenerationPaymentType(request.resource.data);
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
      }
      
      match /transactions/{transactionId} {
        allow read, list: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
        allow create: if request.auth != null
          && request.auth.uid == userId
          && !isDashboardReader();
      }
    }

    // Admin dashboard collection-group queries. No client writes are granted here.
    match /{path=**}/transactions/{transactionId} {
      allow read: if canReadDashboard();
    }

    match /{path=**}/generationDocuments/{documentId} {
      allow read: if canReadDashboard();
    }

    match /{path=**}/generationJobs/{jobId} {
      allow read: if canReadDashboard();
    }
    
    match /schoolEarnings/{schoolId} {
        allow read: if true; // Allow anyone to read for the leaderboard
        allow write: if request.auth != null && !isDashboardReader(); // Exclude read-only dashboard sessions
    }

    match /globalNotifications/{notificationId} {
      allow read, list: if request.auth != null; // Allow any authenticated user to read and list
      allow write: if isAdmin(); // Only admins can create/update/delete
    }

    // Allow admins to read all reports via collection group query
    match /{path=**}/reports/{reportId} {
      allow read: if canReadDashboard();
    }
    
    match /testimonials/{testimonialId} {
      // Anyone can read testimonials
      allow read, list: if true;
      // Any authenticated user can create a testimonial
      allow create: if request.auth != null && !isDashboardReader();
      // Only admins can update or delete testimonials
      allow update, delete: if isAdmin();
    }
  }
}
